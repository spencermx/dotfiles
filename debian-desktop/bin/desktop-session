#!/usr/bin/env bash
# Sway owns this session. Track children so logging out also ends the applets.
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_TYPE=wayland
export BROWSER=firefox-esr
unset DOTFILES_CONSOLE
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/debian-desktop"
mkdir -p -- "$state_dir"
exec >> "$state_dir/session.log" 2>&1
printf '\nSway desktop starting: %s\n' "$(date --iso-8601=seconds)"

# The display values must be imported before portal D-Bus activation.
dbus-update-activation-environment --systemd \
    DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
systemctl --user start pipewire.socket wireplumber.service
systemctl --user --no-block restart xdg-desktop-portal-gtk.service \
    xdg-desktop-portal-wlr.service xdg-desktop-portal.service

pids=()
start() { "$@" & pids+=("$!"); }
cleanup() {
    trap - EXIT TERM INT
    for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done
    wait || true
}
trap cleanup EXIT
trap 'exit 0' TERM INT
start mako
start nm-applet --indicator
start blueman-applet
start /usr/libexec/polkit-mate-authentication-agent-1
start autotiling
start swayidle -w \
    timeout 300 'desktop-control lock' \
    timeout 600 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    before-sleep 'desktop-control lock' \
    after-resume 'swaymsg "output * power on"' \
    lock 'desktop-control lock'
# Wait for Sway's shutdown rather than leaving session daemons in Xfce later.
swaymsg -m -t subscribe '["shutdown"]'
