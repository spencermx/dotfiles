# Retain the user's CLI setup, then correct its console-only assumptions here.
# This is loaded by desktop-terminal, not by physical TTYs or SSH sessions.
if [[ -r $HOME/.bashrc ]]; then . "$HOME/.bashrc"; fi
unset DOTFILES_CONSOLE
export BROWSER=firefox-esr
# open Thunar here, same name as Arch's dolphin alias and mac's Finder
# function. Left out of debian/ on purpose: the console zone has no display.
fe() { thunar "${1:-.}" >/dev/null 2>&1 & disown; }
if [[ -n ${SWAYSOCK:-} ]]; then
    lock() { "$HOME/.local/bin/desktop-control" lock; }
    suspend() { "$HOME/.local/bin/desktop-control" suspend; }
    reboot() { "$HOME/.local/bin/desktop-control" reboot; }
    poweroff() { "$HOME/.local/bin/desktop-control" poweroff; }
fi
