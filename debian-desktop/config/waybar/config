{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "network", "pulseaudio", "backlight", "battery", "tray", "custom/power"],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "persistent-workspaces": {"1": [], "2": [], "3": [], "4": [], "5": []}
    },
    "sway/mode": {"format": "{}"},
    "clock": {"format": "{:%a %H:%M}", "format-alt": "{:%Y-%m-%d %H:%M}", "tooltip-format": "{:%A, %B %d, %Y}"},
    "cpu": {"format": "CPU {usage}%", "interval": 5},
    "memory": {"format": "MEM {percentage}%", "interval": 5},
    "network": {
        "format-wifi": "Wi-Fi {signalStrength}%",
        "format-ethernet": "LAN",
        "format-disconnected": "Offline",
        "tooltip-format-wifi": "{essid}\n{ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "Vol {volume}%",
        "format-muted": "Muted",
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },
    "backlight": {"format": "Light {percent}%"},
    "battery": {
        "format": "Bat {capacity}%",
        "format-charging": "Bat {capacity}% +",
        "format-plugged": "AC {capacity}%",
        "states": {"warning": 25, "critical": 10}
    },
    "tray": {"icon-size": 20, "spacing": 8},
    "custom/power": {"format": "Power", "tooltip": false, "on-click": "~/.local/bin/desktop-control menu"}
}
