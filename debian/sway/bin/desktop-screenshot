#!/usr/bin/env bash
set -euo pipefail
case "${1:-output}" in
    output)
        output=$(swaymsg -t get_outputs | jq -er '.[] | select(.focused) | .name')
        options=(-o "$output")
        ;;
    region)
        geometry=$(slurp) || exit 0
        [[ -n $geometry ]] || exit 0
        options=(-g "$geometry")
        ;;
    *) printf 'Usage: desktop-screenshot [output|region] [delay-seconds]\n' >&2; exit 2 ;;
esac
# Optional delay, so a menu or dropdown can be opened before the capture.
# The notice expires before the shot so it stays out of the picture.
delay=${2:-0}
if (( delay > 0 )); then
    notify-send -t 1500 "Screenshot in ${delay}s"
    sleep "$delay"
fi
if [[ ${1:-output} == output ]]; then
    # Re-read the focused display after the wait, in case focus moved.
    output=$(swaymsg -t get_outputs | jq -er '.[] | select(.focused) | .name')
    options=(-o "$output")
fi
pictures=$(xdg-user-dir PICTURES 2>/dev/null) || pictures="$HOME/Pictures"
directory="${pictures:-$HOME/Pictures}/Screenshots"
mkdir -p -- "$directory"
umask 077
file=$(mktemp "$directory/$(date +%Y-%m-%d_%H-%M-%S).XXXXXX.png")
if ! grim "${options[@]}" "$file"; then
    rm -- "$file"
    exit 1
fi
wl-copy --type image/png < "$file"
notify-send 'Screenshot saved and copied' "$file"
