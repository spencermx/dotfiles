#!/usr/bin/env python3
"""Swap the focused tile with its next sibling (Alt+S on the Arch desktop)."""
import json
import subprocess


def sibling_of_focus(node):
    children = node.get("nodes", [])
    for index, child in enumerate(children):
        if child.get("focused") and len(children) > 1:
            return children[(index + 1) % len(children)]["id"]
        sibling = sibling_of_focus(child)
        if sibling is not None:
            return sibling
    return None


def main():
    tree = json.loads(subprocess.check_output(["swaymsg", "-t", "get_tree"]))
    sibling = sibling_of_focus(tree)
    if sibling is not None:
        subprocess.run(["swaymsg", "swap", "container", "with", "con_id", str(sibling)], check=True)


if __name__ == "__main__":
    main()
