# Arch keyboard workflow on Debian. Mod1 is Alt.
set $mod Mod1
set $bin ~/.local/bin
font pango:JetBrains Mono 11
floating_modifier $mod normal
default_border pixel 1
default_floating_border pixel 1
gaps inner 0
gaps outer 0
focus_follows_mouse yes
client.focused #88c0d0 #2e3440 #eceff4 #a3be8c #88c0d0
client.unfocused #4c566a #2e3440 #d8dee9 #4c566a #4c566a
output * bg #242933 solid_color

input type:keyboard {
    xkb_layout us
}
input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
}

bindsym $mod+Return exec $bin/desktop-terminal
bindsym $mod+d exec $bin/desktop-menu run
bindsym $mod+e exec firefox-esr
bindsym $mod+Shift+f exec thunar
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+a floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# aivim: the same session keys as the Arch desktop.
bindsym $mod+Shift+space exec $bin/aivim --popup pick
bindsym $mod+Shift+n exec $bin/aivim --popup new
bindsym $mod+Shift+c exec $bin/aivim --dup claude
bindsym $mod+Shift+x exec $bin/aivim --dup codex
bindsym $mod+Shift+t exec $bin/aivim --shell
bindsym $mod+Shift+d exec $bin/aivim --kill
bindsym $mod+Shift+a exec $bin/aivim --go need
bindsym $mod+Shift+u exec $bin/aivim --last
bindsym $mod+Shift+bracketleft exec $bin/aivim --go prev
bindsym $mod+Shift+bracketright exec $bin/aivim --go next
bindsym $mod+Shift+1 exec $bin/aivim --go 1
bindsym $mod+Shift+2 exec $bin/aivim --go 2
bindsym $mod+Shift+3 exec $bin/aivim --go 3
bindsym $mod+Shift+4 exec $bin/aivim --go 4
bindsym $mod+Shift+5 exec $bin/aivim --go 5
bindsym $mod+Shift+6 exec $bin/aivim --go 6
bindsym $mod+Shift+7 exec $bin/aivim --go 7
bindsym $mod+Shift+8 exec $bin/aivim --go 8
bindsym $mod+Shift+9 exec $bin/aivim --go 9
bindsym $mod+Shift+0 exec $bin/aivim --go 0
# Keep the picker roomy and the scratch shell close to fullscreen on any display.
for_window [app_id="^aivim-picker$"] floating enable, resize set 65 ppt 75 ppt, move position center
for_window [app_id="^aivim-shell$"] floating enable, resize set 95 ppt 90 ppt, move position center

# Alt+M, then a number, moves a window to a workspace (as on Arch).
bindsym $mod+m mode move
mode move {
    bindsym 1 move container to workspace number 1; mode default
    bindsym 2 move container to workspace number 2; mode default
    bindsym 3 move container to workspace number 3; mode default
    bindsym 4 move container to workspace number 4; mode default
    bindsym 5 move container to workspace number 5; mode default
    bindsym 6 move container to workspace number 6; mode default
    bindsym 7 move container to workspace number 7; mode default
    bindsym 8 move container to workspace number 8; mode default
    bindsym 9 move container to workspace number 9; mode default
    bindsym 0 move container to workspace number 10; mode default
    bindsym Escape mode default
    bindsym Return mode default
}

# Same visible direction as the Arch preselect bindings: g below, v beside.
bindsym $mod+g splitv
bindsym $mod+v splith
bindsym $mod+x layout toggle split
bindsym $mod+s exec $bin/desktop-swap
bindsym $mod+t layout tabbed
bindsym $mod+w scratchpad show
bindsym $mod+Shift+w move scratchpad

bindsym $mod+r mode resize
mode resize {
    bindsym h resize shrink width 10 px
    bindsym l resize grow width 10 px
    bindsym k resize shrink height 10 px
    bindsym j resize grow height 10 px
    bindsym Escape mode default
    bindsym Return mode default
}
bindsym $mod+Control+Shift+c reload
bindsym $mod+Shift+e exec $bin/desktop-control logout
bindsym $mod+Control+l exec $bin/desktop-control lock
bindsym $mod+Shift+p exec $bin/desktop-control menu

bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --locked --no-repeat XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --locked --no-repeat XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl set +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl --min-value=1 set 5%-
bindsym F10 exec brightnessctl set +5%
bindsym F9 exec brightnessctl --min-value=1 set 5%-
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym Print exec $bin/desktop-screenshot output
bindsym Shift+Print exec $bin/desktop-screenshot region

bar {
    swaybar_command waybar
}
exec $bin/desktop-session

# Per-machine output/input settings: monitors, modes, scale, workspace
# placement. 2-link-dotfiles.sh links this path to hosts/<hostname>.conf when
# that machine has one; otherwise there is no file and sway skips the include.
# Without it, outputs are auto-detected at scale 1.0, which on a HiDPI panel
# makes the font sizes above render far too small. See hosts/deb.conf.
include ~/.config/sway/local.conf
