# macOS git config.
#
# Deliberately mac's own copy. The Linux equivalent hardcodes /usr/bin/gh
# for the credential helper, and Homebrew installs gh to $(brew --prefix)/bin.
# Here gh is invoked bare and resolved through PATH, which works on both Apple
# Silicon (/opt/homebrew) and Intel (/usr/local).

[user]
	name = spencermx
	email = 138399420+spencermx@users.noreply.github.com

# The empty first helper clears any helper inherited from system config --
# without it, osxkeychain runs first and gh never gets asked.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[core]
	excludesfile = ~/.config/git/ignore

[init]
	defaultBranch = master
