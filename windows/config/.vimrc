set scrolloff=999

set number relativenumber

set tabstop=4
set shiftwidth=4
set expandtab
set softtabstop=4

set clipboard=unnamed

let g:netrw_localcopydircmd = 'cp -r'
let g:netrw_localrmdir = '/usr/bin/rm -rf'

inoremap jk <Esc>
"nnoremap jk <Esc>

nnoremap <Space>s :w<CR>

nnoremap <C-u> <C-u>
nnoremap <C-d> <C-d>
